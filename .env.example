WORDPRESS_TEMPLATE=template/latest.tar.gz
WORDPRESS_TEMPLATE_SQL=sql/latest.sql
IMAGE_NAME=ols-wp:latest
CONTAINER_NAME=ols-wp
HTTP_PORT=8080
OLS_ADMIN_PORT=7080

# Required database settings
WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=wp
WORDPRESS_DB_USER=user
WORDPRESS_DB_PASSWORD=pwd

# Optional WordPress settings
WORDPRESS_DB_CHARSET=utf8mb4
WORDPRESS_DB_COLLATE=
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=false
WORDPRESS_DISALLOW_FILE_EDIT=true
# 登陆页必须使用HTTPS
WORDPRESS_FORCE_SSL_ADMIN=false
# 网站使用HTTPS访问
WORDPRESS_BEHIND_PROXY=1
WORDPRESS_HOME=https://example.com
WORDPRESS_SITEURL=https://example.com

# Optional raw PHP inserted into wp-config.php before the stop marker.
# WORDPRESS_CONFIG_EXTRA=define( 'WP_MEMORY_LIMIT', '256M' );
