# 1Panel 专用环境变量配置
# 使用方式：在 1Panel 编排管理中直接粘贴此文件内容，或通过 --env-file 指定

# 站点名称（影响容器名）
SITE_NAME=ols-wp

# 端口配置
HTTP_PORT=8080
OLS_ADMIN_PORT=7080

# 数据库配置（必填）
WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change-me-please

# 数据库可选配置
WORDPRESS_DB_PORT=3306
WORDPRESS_DB_CHARSET=utf8mb4
WORDPRESS_DB_COLLATE=
WORDPRESS_TABLE_PREFIX=wp_

# WordPress 配置
WORDPRESS_DEBUG=false
WORDPRESS_DISALLOW_FILE_EDIT=true
WORDPRESS_FORCE_SSL_ADMIN=false
WORDPRESS_BEHIND_PROXY=1

# 固定站点 URL（可选，一般留空）
WORDPRESS_HOME=
WORDPRESS_SITEURL=

# 自定义 PHP 配置（可选）
# WORDPRESS_CONFIG_EXTRA=
